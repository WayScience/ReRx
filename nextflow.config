// ReRx Alpine pilot — Nextflow/Slurm configuration.
// Skill-proven pattern: head on Persistence1, Slurm executor, acpu
// partition, account amc-general, queueSize 200 (matches MaxJobs=200).
// Containers are invoked directly by the task driver via apptainer,
// so Nextflow itself needs no container scopes here.

process {
    executor       = 'slurm'
    queue          = 'acpu'
    clusterOptions = '--account=amc-general --qos=cpu-normal'
    cpus   = 2
    memory = 4.GB
    time   = 2.h

    // Transient Slurm hiccups (node preemption, brief scheduler errors)
    // should not force a full pipeline rerun; retry a few times with
    // backoff before giving up. errorStrategy 'retry' resubmits the
    // same task; maxRetries caps it so a genuinely broken task still
    // fails the run instead of looping forever.
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: PREPARE {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }
    withName: CELLPROFILER {
        cpus   = 8
        memory = 32.GB
        time   = 2.h
        maxForks = 16
    }
    withName: CYTOTABLE {
        cpus   = 4
        memory = 32.GB
        time   = 1.h
        maxForks = 16
    }
    withName: CROPS {
        cpus   = 4
        memory = 16.GB
        time   = 1.h
        maxForks = 16
    }
    withName: MORPHEM {
        cpus   = 8
        memory = 64.GB
        time   = 2.h
        maxForks = 32
    }
    withName: FINALIZE {
        cpus   = 4
        memory = 64.GB
        time   = 2.h
    }
}

executor {
    queueSize = 200
    pollInterval = '20s'
    queueStatInterval = '1m'
    exitReadTimeout = '270s'
}

workDir = '/scratch/alpine/dabu57888@xsede.org/rerx/nextflow_work'
